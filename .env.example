# Environment Variables for ASEVA Frontend

# Supabase Public Configuration (Safe to expose to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Paystack Public Key for Checkout (Public key only, NOT the secret key)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...

# App Configuration
VITE_APP_NAME=ASEVA
VITE_APP_URL=http://localhost:3000
VITE_CURRENCY=NGN
VITE_TIMEZONE=Africa/Lagos

# NOTICE: NEVER place SUPABASE_SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY,
# or RESEND_API_KEY in this file or any VITE_* variable.
